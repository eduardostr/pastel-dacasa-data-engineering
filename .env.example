# Apenas configuração demonstrativa de desenvolvimento.
# Copie para .env somente se ele ainda não existir e defina sua senha local.
POSTGRES_USER=pastelflow
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
POSTGRES_DB=pastelflow_oltp
# Backend: localhost:5432, driver psycopg2, configurados em backend/app/database.py.
# DATABASE_URL não é utilizada pelo backend e foi removida deste exemplo.
# ETL: usa os valores acima; ETL_DATABASE_URL é uma alternativa opcional.
